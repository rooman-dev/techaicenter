---
import { hero } from '../data/site';
import { isFilled } from '../data/utils';

const [first] = hero.rotations;

/* Reserve room for the tallest pair so the swap never moves the page. */
const longestHeadline = hero.rotations.reduce((a, r) => (r.headline.length > a.length ? r.headline : a), '');
const longestMessage = hero.rotations.reduce((a, r) => (r.message.length > a.length ? r.message : a), '');
---

<section id="hero" class="hero">
  <p class="hero__eyebrow reveal" style="animation-delay:0.06s">
    <span class="hero__dots" aria-hidden="true">
      {hero.eyebrowDots.map((color) => <span class="hero__dot" style={`background:${color};`} />)}
    </span>
    {isFilled(hero.eyebrowText) && <span class="hero__eyebrow-text">{hero.eyebrowText}</span>}
  </p>

  <div
    class="rotator"
    data-rotator
    data-rotations={JSON.stringify(hero.rotations)}
    data-hold="4000"
  >
    <h1 class="hero__headline">
      {/* Sized from the longest pair; the visible line is layered on top. */}
      <span class="rotator__ghost" aria-hidden="true">{longestHeadline}</span>
      <span class="rotator__headline" data-rotator-headline>{first.headline}</span>
    </h1>

    <p class="hero__intro">
      <span class="rotator__ghost" aria-hidden="true">{longestMessage}</span>
      <span class="rotator__message" aria-live="polite" data-rotator-message>{first.message}</span>
    </p>

    <div class="dots" role="tablist" aria-label="Hero messages">
      {
        hero.rotations.map((rotation, index) => (
          <button
            class="dots__dot"
            type="button"
            role="tab"
            aria-label={rotation.headline}
            aria-selected={index === 0 ? 'true' : 'false'}
            data-rotator-dot={index}
          />
        ))
      }
    </div>
  </div>

  <div class="hero__body reveal" style="animation-delay:0.26s">
    <div class="hero__buttons">
      {
        hero.buttons.map((button) => (
          <a class={`hero__button hero__button--${button.variant}`} href={button.href}>
            {button.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="hero__stats reveal" style="animation-delay:0.36s">
    {
      hero.stats
        .filter((stat) => isFilled(stat.value))
        .map((stat) => (
          <div class="hero__stat">
            <p class="hero__stat-value">{stat.value}</p>
            <p class="hero__stat-label">{stat.label}</p>
          </div>
        ))
    }
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    margin: 0 auto;
    width: 100%;
    max-width: var(--container);
    padding: calc(var(--section-gap) / 2) var(--pad);
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }

  .hero__dots {
    display: flex;
    gap: 6px;
  }

  .hero__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .hero__eyebrow-text {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
  }

  /* Each line is stacked over an invisible copy of the longest variant, so the
     block keeps its height through every swap. */
  .rotator__ghost {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }

  /* Both lines are pinned to the BOTTOM of their reserved box: a short
     headline then sits next to its message instead of leaving a gap between
     them, and the block still never changes height. */
  .rotator__headline,
  .rotator__message {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .hero__headline,
  .hero__intro {
    position: relative;
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(2.25rem, 8.6cqi, 5.5rem);
    /* Big Shoulders' ink runs taller than its em box; 1.12 clears the
       descenders in Chromium as well as WebKit. */
    line-height: 1.12;
    letter-spacing: -0.5px;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .rotator__headline {
    /* Typed in with a stepped clip; padding keeps descenders out of the clip. */
    padding-bottom: 0.08em;
    clip-path: inset(0 100% 0 0);
  }

  .rotator[data-state='typing'] .rotator__headline {
    animation: hero-type var(--type-ms, 900ms) steps(var(--steps, 30), end) forwards;
  }

  .rotator[data-state='holding'] .rotator__headline,
  .rotator[data-state='idle'] .rotator__headline {
    clip-path: inset(0 0 0 0);
  }

  .rotator[data-state='leaving'] .rotator__headline {
    animation: hero-untype 420ms steps(var(--steps, 30), end) forwards;
  }

  @keyframes hero-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes hero-untype {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 100% 0 0);
    }
  }

  .hero__intro {
    margin: 1.25rem 0 0;
    max-width: 44rem;
    font-size: var(--copy);
    line-height: 1.6;
    color: var(--text-body);
  }

  .rotator__message {
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  .rotator[data-state='typing'] .rotator__message,
  .rotator[data-state='leaving'] .rotator__message {
    opacity: 0;
  }

  .dots {
    display: flex;
    gap: 2px;
    margin: 1.5rem 0 0 -12px;
  }

  .dots__dot {
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .dots__dot::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--hairline);
    transition: background 0.3s ease;
  }

  .dots__dot[aria-selected='true']::after {
    background: var(--accent);
  }

  .hero__body {
    margin-top: 2rem;
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: 999px;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: var(--body-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .hero__button--solid {
    border: 1px solid var(--hairline);
    color: var(--text-primary);
  }

  .hero__button--solid:hover,
  .hero__button--solid:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero__button--ghost {
    border: 1px solid transparent;
    color: var(--text-secondary);
  }

  .hero__button--ghost:hover,
  .hero__button--ghost:focus-visible {
    color: var(--text-primary);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 3.5rem;
    border-top: 1px solid var(--hairline);
  }

  .hero__stat {
    padding: 1.5rem 0;
  }

  .hero__stat + .hero__stat {
    border-top: 1px solid var(--hairline);
  }

  .hero__stat-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(2.5rem, 4cqi, 3.5rem);
    line-height: 1.15;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .hero__stat-label {
    margin: 0.375rem 0 0;
    font-size: var(--copy-sm);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .hero__stats {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
    }

    .hero__stat {
      padding: 2rem 2rem 2rem 0;
    }

    .hero__stat + .hero__stat {
      border-top: none;
      border-left: 1px solid var(--hairline);
      padding-left: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator__headline {
      clip-path: none;
      animation: none !important;
    }

    .rotator__message {
      opacity: 1 !important;
      transition: none;
    }
  }
</style>

<script>
  // Hero rotator. Pair one is already in the HTML; this only swaps text and
  // toggles a state attribute that the CSS animates.
  (() => {
    const root = document.querySelector<HTMLElement>('[data-rotator]');
    if (!root) return;

    const headline = root.querySelector<HTMLElement>('[data-rotator-headline]');
    const message = root.querySelector<HTMLElement>('[data-rotator-message]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rotator-dot]'));
    if (!headline || !message) return;

    let pairs: { headline: string; message: string }[] = [];
    try {
      pairs = JSON.parse(root.dataset.rotations ?? '[]');
    } catch {
      return;
    }
    if (pairs.length < 2) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const hold = Number(root.dataset.hold ?? 4000);
    let index = 0;
    let timer = 0;
    let paused = false;

    const setState = (state: string) => root.setAttribute('data-state', state);

    const paint = (i: number) => {
      const pair = pairs[i];
      root.style.setProperty('--steps', String(Math.max(pair.headline.length, 1)));
      root.style.setProperty('--type-ms', `${Math.min(1400, 320 + pair.headline.length * 26)}ms`);
      headline.textContent = pair.headline;
      message.textContent = pair.message;
      dots.forEach((dot, d) => dot.setAttribute('aria-selected', String(d === i)));
    };

    const schedule = (ms: number, fn: () => void) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (paused) {
          schedule(400, fn);
          return;
        }
        fn();
      }, ms);
    };

    const show = (i: number) => {
      index = (i + pairs.length) % pairs.length;
      paint(index);
      setState('typing');
      schedule(1500, () => {
        setState('holding');
        schedule(hold, () => {
          setState('leaving');
          schedule(500, () => show(index + 1));
        });
      });
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        window.clearTimeout(timer);
        show(i);
      })
    );

    // Pause while someone is reading or tabbing through it.
    ['pointerenter', 'focusin'].forEach((evt) => root.addEventListener(evt, () => (paused = true)));
    ['pointerleave', 'focusout'].forEach((evt) => root.addEventListener(evt, () => (paused = false)));
    document.addEventListener('visibilitychange', () => (paused = document.hidden));

    setState('holding');
    schedule(hold, () => show(1));
  })();
</script>
