---
import { hero } from '../data/site';
import { isFilled } from '../data/utils';
import VideoFrame from './VideoFrame.astro';
---

<section id="hero" class="hero">
  <p class="hero__eyebrow reveal" style="animation-delay:0.06s">
    <span class="hero__dots" aria-hidden="true">
      {hero.eyebrowDots.map((color) => <span class="hero__dot" style={`background:${color};`} />)}
    </span>
    {isFilled(hero.eyebrowText) && <span class="hero__eyebrow-text">{hero.eyebrowText}</span>}
  </p>

  <h1 class="hero__headline oh">
    <span class="hero__headline-line">
      <span class="type type--one">
        <span class="type__text">{hero.headlineLine1}</span>
        <span class="type__caret" aria-hidden="true"></span>
      </span>
    </span>
    <span class="hero__headline-line hero__headline-line--accent hl">
      <span class="type type--two">
        <span class="type__text">{hero.headlineLine2}</span>
        <span class="type__caret" aria-hidden="true"></span>
      </span>
    </span>
  </h1>

  <div class="hero__body reveal" style="animation-delay:0.26s">
    <div class="hero__left">
      <p class="hero__intro">{hero.intro}</p>
      <div class="hero__buttons">
        {
          hero.buttons.map((button) => (
            <a class={`hero__button hero__button--${button.variant}`} href={button.href}>
              {button.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__media">
      <VideoFrame />
    </div>
  </div>

  <div class="hero__stats reveal" style="animation-delay:0.36s">
    {
      hero.stats.filter((stat) => isFilled(stat.value)).map((stat) => (
        <div class="hero__stat">
          <p class="hero__stat-value">{stat.value}</p>
          <p class="hero__stat-label">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Mobile-first: single column throughout. The desktop grid, the 118px
     headline and the divided stats row arrive at the 64rem breakpoint. */
  .hero {
    margin: 0 auto;
    width: 100%;
    max-width: 68rem;
    padding: 4rem 1.25rem 3rem;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }

  .hero__dots {
    display: flex;
    gap: 6px;
  }

  .hero__dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .hero__eyebrow-text {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 54px;
    line-height: 0.92;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  .hero__headline-line {
    display: block;
  }

  /* Typewriter. The TEXT is clipped — nothing opaque slides over it, so the
     background gradient behind the headline is never covered.
     Step counts are the character counts of the two lines: 24 and 28. */
  .type {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .type__text {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
  }

  .type__caret {
    position: absolute;
    top: 0.08em;
    bottom: 0.08em;
    left: 0;
    width: 3px;
    background: currentColor;
  }

  .type--one .type__text {
    animation: type-reveal 1.45s steps(24, end) 0.4s both;
  }

  .type--one .type__caret {
    animation:
      caret-travel 1.45s steps(24, end) 0.4s both,
      caret-out 0.01s linear 1.85s forwards;
  }

  .type--two .type__text {
    animation: type-reveal 1.7s steps(28, end) 2s both;
  }

  .type--two .type__caret {
    animation:
      caret-travel 1.7s steps(28, end) 2s both,
      caret-blink 0.9s step-end 3.7s infinite;
  }

  @keyframes type-reveal {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes caret-travel {
    from {
      left: 0;
    }
    to {
      left: 100%;
    }
  }

  @keyframes caret-out {
    to {
      opacity: 0;
    }
  }

  @keyframes caret-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .hero__headline-line--accent {
    color: var(--accent);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .hero__left {
    max-width: 600px;
  }

  .hero__intro {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__button {
    border-radius: 999px;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: var(--body-weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .hero__button--solid {
    border: 1px solid var(--hairline);
    color: var(--text-primary);
  }

  .hero__button--solid:hover,
  .hero__button--solid:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero__button--ghost {
    border: 1px solid transparent;
    color: var(--text-secondary);
  }

  .hero__button--ghost:hover,
  .hero__button--ghost:focus-visible {
    color: var(--text-primary);
  }

  /* Desktop-only: the frame is fixed-width and has no mobile form yet. */
  .hero__media {
    display: none;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 3.5rem;
    border-top: 1px solid var(--hairline);
  }

  .hero__stat {
    padding: 1.5rem 0;
  }

  .hero__stat + .hero__stat {
    border-top: 1px solid var(--hairline);
  }

  .hero__stat-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 56px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .hero__stat-label {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .hero {
      padding: 6rem 1.25rem 4rem;
    }

    .hero__headline {
      font-size: 118px;
    }

    .hero__body {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
    }

    .hero__left {
      flex: 0 0 600px;
      width: 600px;
    }

    .hero__media {
      display: block;
      flex: 0 0 540px;
      width: 540px;
    }

    .hero__stats {
      /* Adapts to hero.stats length rather than assuming three. */
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
    }

    .hero__stat {
      padding: 2rem 2rem 2rem 0;
    }

    .hero__stat + .hero__stat {
      border-top: none;
      border-left: 1px solid var(--hairline);
      padding-left: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .type__text {
      clip-path: none;
      animation: none;
    }

    .type__caret {
      display: none;
    }
  }
</style>
