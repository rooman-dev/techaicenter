---
import { format } from '../data/site';

const tw = (text: string, seconds = 0.9) =>
  `animation-duration:${seconds}s; animation-timing-function: steps(${Math.max(text.length, 1)}, end);`;
---

<section id="format" class="format">
  <div class="format__header">
    <p class="format__label">{format.label}</p>
    <div class="format__headline">
      <h2 class="format__heading oh">
        <span class="tw" style={tw(`${format.headingLead} ${format.headingTail}`, 1.1)}>
          {format.headingLead}{' '}
          <span class="format__heading-tail hl">{format.headingTail}</span>
        </span>
      </h2>
      <p class="format__intro">{format.intro}</p>
    </div>
  </div>

  <div class="format__panel">
    <div class="format__columns">
      <div class="format__benefits">
        <h3 class="format__subheading">{format.benefitsHeading}</h3>
        <ul class="format__grid">
          {
            format.benefits.map((benefit) => (
              <li class="format__benefit">
                <span class="format__dash" aria-hidden="true">
                  —
                </span>
                <p class="format__benefit-title">{benefit.title}</p>
                <p class="format__benefit-detail">{benefit.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="format__facts">
        {
          format.facts.map((fact) => (
            <div class="format__fact">
              <p class="format__fact-label">{fact.label}</p>
              <p class={`format__fact-value${fact.accent ? ' format__fact-value--accent' : ''}`}>
                {fact.value}
              </p>
              {fact.note && <p class="format__fact-note">{fact.note}</p>}
            </div>
          ))
        }
      </div>
    </div>

    <div class="format__supply">
      <span class="format__supply-label">{format.supplyLabel}</span>
      <ul class="format__supply-list">
        {format.supplyItems.map((item) => <li class="format__supply-item">{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .format {
    margin: 0 auto;
    width: 100%;
    max-width: 68rem;
    padding: calc(var(--section-gap) / 2) var(--pad);
  }

  .format__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .format__label {
    margin: 0;
    flex: none;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--section-01);
  }

  .format__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 44px;
    line-height: 0.96;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .format__heading-tail {
    color: var(--text-muted);
  }

  .format__intro {
    margin: 1.25rem 0 0;
    max-width: 44rem;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-body);
  }

  /* Glass is allowed on the format panel. */
  .format__panel {
    margin-top: 3rem;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    overflow: hidden;
  }

  .format__columns {
    display: flex;
    flex-direction: column;
  }

  .format__benefits {
    flex: 1;
    padding: 1.75rem;
  }

  .format__subheading {
    margin: 0 0 1.5rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
    font-weight: var(--body-weight-semibold);
  }

  .format__grid {
    display: grid;
    grid-template-columns: 1fr;
    /* 1 col phones, 2 from tablet up. */
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .format__dash {
    display: block;
    margin-bottom: 0.375rem;
    color: var(--accent);
    line-height: 1;
  }

  .format__benefit-title {
    margin: 0;
    font-size: 15px;
    font-weight: var(--body-weight-semibold);
    color: var(--text-primary);
  }

  .format__benefit-detail {
    margin: 0.25rem 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .format__facts {
    border-top: 1px solid var(--hairline);
    padding: 1.75rem;
  }

  .format__fact + .format__fact {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .format__fact-label {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
  }

  .format__fact-value {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 40px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .format__fact-value--accent {
    color: var(--accent);
  }

  .format__fact-note {
    margin: 0.5rem 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .format__supply {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    border-top: 1px solid var(--hairline);
    padding: 1.125rem 1.75rem;
  }

  .format__supply-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
  }

  .format__supply-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .format__supply-item + .format__supply-item::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--text-placeholder);
  }

  @media (min-width: 48rem) {
    .format__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .format {
      padding: calc(var(--section-gap) / 2) var(--pad);
    }

    .format__header {
      flex-direction: row;
      gap: 0;
    }

    .format__label {
      width: 130px;
      padding-top: 0.75rem;
    }

    .format__headline {
      flex: 1;
    }

    .format__heading {
      font-size: 74px;
    }

    .format__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .format__columns {
      flex-direction: row;
    }

    .format__benefits {
      padding: 2.25rem;
    }

    .format__facts {
      flex: 0 0 330px;
      width: 330px;
      border-top: none;
      border-left: 1px solid var(--hairline);
      padding: 2.25rem;
    }

    .format__supply {
      padding: 1.125rem 2.25rem;
    }
  }
</style>
