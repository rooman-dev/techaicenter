---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { aiLauncher } from '../data/site';
---

{/*
  TODO before launch: this is deliberately a jump link to the contact form,
  which it prefills with a draft brief — no backend, nothing faked. Once the
  serverless function exists it becomes a button opening the chat panel, and
  aiLauncher.subtitle changes to 'AI assistant · replies instantly'.
*/}
<a class="launcher" href={aiLauncher.href} data-launcher data-draft={aiLauncher.draft}>
  <span class="launcher__mark">
    <span class="launcher__ring" aria-hidden="true"></span>
    <Image class="launcher__logo" src={logo} alt={aiLauncher.logoAlt} height={30} />
  </span>

  <span class="launcher__text">
    <span class="launcher__title">{aiLauncher.title}</span>
    <span class="launcher__subtitle">{aiLauncher.subtitle}</span>
  </span>
</a>

<style>
  .launcher {
    position: fixed;
    right: 16px;
    bottom: 20px;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    padding: 11px 22px 11px 12px;
    box-shadow: 0 24px 50px -12px rgba(0, 0, 0, 0.8);
    text-decoration: none;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .launcher:hover,
  .launcher:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .launcher__mark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .launcher__logo {
    position: relative;
    z-index: 1;
    height: 30px;
    width: auto;
    border-radius: 50%;
  }

  .launcher__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: launcher-ring 2.4s ease-out infinite;
  }

  @keyframes launcher-ring {
    0% {
      transform: scale(0.7);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .launcher__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .launcher__title {
    font-size: 13px;
    font-weight: var(--body-weight-medium);
    color: var(--text-primary);
    line-height: 1.3;
  }

  .launcher__subtitle {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.3;
  }

  @media (min-width: 64rem) {
    .launcher {
      right: 40px;
      bottom: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .launcher {
      transition: none;
    }

    .launcher:hover,
    .launcher:focus-visible {
      transform: none;
    }

    .launcher__ring {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  // Jumps to the enquiry form and prefills the message with a draft brief.
  // No backend: this only fills a field the visitor can edit or clear.
  (() => {
    const KEY = 'tac:draft';

    const prefill = (draft: string) => {
      const field = document.querySelector<HTMLTextAreaElement>('#brief');
      if (!field || field.value.trim() !== '') return false;
      field.value = draft;
      return true;
    };

    const launcher = document.querySelector<HTMLAnchorElement>('[data-launcher]');

    if (launcher) {
      launcher.addEventListener('click', (event) => {
        const draft = launcher.dataset.draft ?? '';
        const contact = document.querySelector('#contact');

        if (contact) {
          // Already on the page holding the form.
          event.preventDefault();
          prefill(draft);
          contact.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        // On a legal page: hand the draft to the home page we are about to load.
        try {
          sessionStorage.setItem(KEY, draft);
        } catch {
          /* private mode — the jump still works, just without the draft */
        }
      });
    }

    // Landing after that jump.
    try {
      const pending = sessionStorage.getItem(KEY);
      if (pending) {
        sessionStorage.removeItem(KEY);
        prefill(pending);
      }
    } catch {
      /* storage unavailable; nothing to restore */
    }
  })();
</script>
