---
import { contact } from '../data/site';

const { fitCheck } = contact;

const tw = (text: string, seconds = 0.9) =>
  `animation-duration:${seconds}s; animation-timing-function: steps(${Math.max(text.length, 1)}, end);`;

const halves = contact.fields.filter((field) => field.half);
const rest = contact.fields.filter((field) => !field.half);
---

<section id="contact" class="contact">
  <div class="contact__inner">
    <p class="contact__label">{contact.label}</p>

    <div class="contact__columns">
      <div class="contact__left">
        <h2 class="contact__heading oh">
          <span class="contact__heading-line">
            <span class="tw" style={tw(contact.headingLine1, 0.6)}>{contact.headingLine1}</span>
          </span>
          <span class="contact__heading-line contact__heading-line--accent hl">
            <span class="tw" style={tw(contact.headingLine2, 0.9)}>{contact.headingLine2}</span>
          </span>
        </h2>
        <p class="contact__intro">{contact.intro}</p>

        <dl class="details">
          {
            contact.details.map((detail) => (
              <div class="details__row">
                <dt class="details__label">{detail.label}</dt>
                <dd class="details__value">
                  {detail.href ? (
                    <a
                      class="details__link"
                      href={detail.href}
                      target={detail.external ? '_blank' : undefined}
                      rel={detail.external ? 'noopener noreferrer' : undefined}
                    >
                      {detail.value}
                    </a>
                  ) : (
                    detail.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="contact__right">
        <div class="fit">
          <p class="fit__eyebrow">
            <span class="fit__dot" aria-hidden="true"></span>
            {fitCheck.eyebrow}
          </p>
          <p class="fit__body">{fitCheck.body}</p>

          {/*
            TODO before launch: this button is inert by design. Generating an
            angle needs a serverless function (Netlify Function) to call a model
            with the submitted URL. Until that exists it must stay type="button"
            with no handler — do not fake or hardcode a result.
          */}
          <div class="fit__row">
            <label class="fit__label" for="fit-url">{fitCheck.inputLabel}</label>
            <input
              class="fit__input"
              id="fit-url"
              name="fit-url"
              type="url"
              placeholder={fitCheck.placeholder}
            />
            <button class="fit__button" type="button">{fitCheck.buttonLabel}</button>
          </div>
        </div>

        <form
          class="form"
          name={contact.formName}
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value={contact.formName} />
          <p class="form__honeypot">
            <label>
              Do not fill this in
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="form__row">
            {
              halves.map((field) => (
                <div class="field">
                  <label class="field__label" for={field.id}>
                    {field.label}
                  </label>
                  <input
                    class="field__control"
                    id={field.id}
                    name={field.name}
                    type={field.type ?? 'text'}
                    autocomplete={field.autocomplete}
                  />
                </div>
              ))
            }
          </div>

          {
            rest.map((field) => (
              <div class="field">
                <label class="field__label" for={field.id}>
                  {field.label}
                </label>
                {field.multiline ? (
                  <textarea class="field__control" id={field.id} name={field.name} rows="4" />
                ) : (
                  <input
                    class="field__control"
                    id={field.id}
                    name={field.name}
                    type={field.type ?? 'text'}
                    autocomplete={field.autocomplete}
                  />
                )}
              </div>
            ))
          }

          <button class="form__submit" type="submit">{contact.submitLabel}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    width: 100%;
    border-top: 1px solid var(--hairline);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
  }

  .contact__inner {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 68rem;
    padding: 4rem 1.25rem;
  }

  .contact__label {
    margin: 0;
    flex: none;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--section-06);
  }

  .contact__columns {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 42px;
    line-height: 0.92;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .contact__heading-line {
    display: block;
  }

  .contact__heading-line--accent {
    color: var(--accent);
  }

  .contact__intro {
    margin: 1.25rem 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .details {
    margin: 2rem 0 0;
  }

  .details__row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-top: 1px solid var(--hairline);
    padding: 0.875rem 0;
  }

  .details__row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .details__label {
    flex: 0 0 92px;
    width: 92px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--text-muted);
  }

  .details__value {
    margin: 0;
    min-width: 0;
    font-size: 15px;
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .details__link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .details__link:hover,
  .details__link:focus-visible {
    color: var(--accent);
  }

  /* Fit-check panel — glass is allowed on the contact band. */
  .fit {
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--glass-bg);
    padding: 1.5rem;
  }

  .fit__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.6px;
    color: var(--accent);
  }

  .fit__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .fit__body {
    margin: 0.75rem 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .fit__row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .fit__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--text-muted);
  }

  .fit__input {
    flex: 1;
    min-width: 0;
    border: none;
    border-bottom: 1px solid var(--hairline);
    background: transparent;
    padding: 0.5rem 0;
    /* 16px: anything smaller makes iOS zoom the page on focus. */
    font-size: 16px;
    font-family: inherit;
    color: var(--text-primary);
    transition: border-color 200ms ease;
  }

  .fit__input::placeholder {
    color: var(--text-placeholder);
  }

  .fit__input:focus {
    outline: none;
    border-bottom-color: var(--cyan);
  }

  .fit__button {
    width: 100%;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    padding: 0.5rem 1.125rem;
    font-family: inherit;
    font-size: 14px;
    color: var(--accent);
    cursor: pointer;
    white-space: nowrap;
    transition: background 200ms ease;
  }

  .fit__button:hover,
  .fit__button:focus-visible {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .form {
    margin-top: 2rem;
  }

  .form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .form__row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
    min-width: 0;
  }

  .form__row + .field,
  .field + .field {
    margin-top: 1.5rem;
  }

  .field__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--text-muted);
  }

  .field__control {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--hairline);
    background: transparent;
    padding: 0.5rem 0;
    /* 16px: anything smaller makes iOS zoom the page on focus. */
    font-size: 16px;
    font-family: inherit;
    color: var(--text-primary);
    transition: border-color 200ms ease;
  }

  .field__control:focus {
    outline: none;
    border-bottom-color: var(--cyan);
  }

  textarea.field__control {
    resize: vertical;
    line-height: 1.6;
  }

  .form__submit {
    width: 100%;
    margin-top: 2rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: transparent;
    padding: 0.75rem 1.5rem;
    font-family: inherit;
    font-size: 15px;
    font-weight: var(--body-weight-medium);
    color: var(--text-primary);
    cursor: pointer;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }

  .form__submit:hover,
  .form__submit:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .contact__inner {
      flex-direction: row;
      gap: 0;
      padding: 6rem 1.25rem;
    }

    .contact__label {
      width: 130px;
      padding-top: 1rem;
    }

    .contact__columns {
      flex: 1;
      min-width: 0;
      flex-direction: row;
      gap: 72px;
    }

    .contact__left {
      flex: 0 0 480px;
      width: 480px;
    }

    .contact__right {
      flex: 1;
      min-width: 0;
    }

    .contact__heading {
      font-size: 74px;
    }

    .fit__row {
      flex-direction: row;
      align-items: flex-end;
      flex-wrap: wrap;
    }

    .fit__label {
      flex: 0 0 100%;
    }

    .fit__button {
      width: auto;
    }

    .form__row {
      flex-direction: row;
      gap: 1.5rem;
    }

    .form__submit {
      width: auto;
    }
  }
</style>
