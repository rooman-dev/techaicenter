---
import { Image } from 'astro:assets';
import { work, testimonials, showTestimonials } from '../data/site';

const tw = (text: string, seconds = 0.9) =>
  `animation-duration:${seconds}s; animation-timing-function: steps(${Math.max(text.length, 1)}, end);`;

---

<section id="work" class="work">
  <div class="work__inner">
    <p class="work__label">{work.label}</p>

    <div class="work__content">
      <div class="work__header">
        <h2 class="work__heading">
          <span class="tw" style={tw(work.heading)}>{work.heading}</span>
        </h2>
        <p class="work__note">{work.note}</p>
      </div>

      <div class="work__cards">
        <div class="grid">
      {
        work.entries.map((entry) => (
          <a
            class="cell"
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Watch on YouTube: ${entry.title}`}
          >
            <div class="cell__well">
              <Image class="cell__img" src={entry.thumb} alt={entry.thumbAlt} loading="lazy" />
            </div>
            <div class="cell__body">
              <p class="cell__brand">
                {entry.brand}
                {entry.repeatClient && <span class="cell__tag">{work.repeatTag}</span>}
              </p>
              <p class="cell__title">{entry.title}</p>
              <p class="cell__scope">{entry.scope}</p>
              <p class="cell__cta">{work.entryCta}</p>
            </div>
          </a>
          ))
        }
        </div>
      </div>

      {
        showTestimonials && (
          <ul class="voices">
            {testimonials.map((testimonial) => (
              <li class="voice">
                <blockquote class="voice__quote">{testimonial.quote}</blockquote>
                <p class="voice__by">
                  {testimonial.name} · {testimonial.brand}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Same container and header shape as every other section: the 0X label
     sits in its own left column and the heading starts at the shared indent. */
  .work {
    width: 100%;
    padding: calc(var(--section-gap) / 2) 0;
  }

  .work__inner {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: var(--container);
    padding: 0 var(--pad);
  }

  .work__header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .work__label {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--section-01);
  }

  .work__heading {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(2.5rem, 7vw, 3rem);
    line-height: 1.12;
    letter-spacing: var(--display-tracking);
    color: var(--text-primary);
  }

  .work__note {
    margin: 0;
    font-size: var(--copy-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .work__cards {
    margin-top: 2.5rem;
  }

  /* Six equal cards. 1px gaps over a hairline ground read as dividing rules. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--hairline);
  }

  /* 2 across on tablets, 3 from desktop. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cell {
    display: block;
    background: var(--bg-stop-2);
    text-decoration: none;
    transition: background 0.35s ease;
  }

  .cell:hover,
  .cell:focus-visible {
    background: color-mix(in srgb, var(--text-primary) 4%, var(--bg-stop-2));
  }

  .cell__well {
    display: flex;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
  }

  .cell__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .cell:hover .cell__img,
  .cell:focus-visible .cell__img {
    transform: scale(1.06);
  }

  .cell__body {
    padding: 1.25rem;
  }

  .cell__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 24px;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .cell__tag {
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--green-repeat-client);
  }

  .cell__title {
    margin: 0.75rem 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .cell__scope {
    margin: 0.5rem 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cell__cta {
    margin: 1rem 0 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--text-placeholder);
  }

  /* Testimonials: one glass card per quote, below the grid. */
  .voices {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .voice {
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: var(--glass-bg);
    padding: 1.75rem;
  }

  .voice__quote {
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--body-weight-medium);
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .voice__by {
    margin: 1.25rem 0 0;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .work__inner {
      flex-direction: row;
      gap: 0;
    }

    .work__label {
      width: 130px;
      flex: none;
      padding-top: 1rem;
    }

    .work__content {
      flex: 1;
      min-width: 0;
    }

    .work__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
    }

    .work__heading {
      font-size: clamp(3rem, 5.6vw, 5rem);
    }

    .work__note {
      flex: 0 0 300px;
      width: 300px;
      padding-top: 0.75rem;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .voices {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell__img,
    .cell {
      transition: none;
    }

    .cell:hover .cell__img,
    .cell:focus-visible .cell__img {
      transform: none;
    }
  }
</style>
