---
import { Image } from 'astro:assets';
import { featuredVideo, work } from '../data/site';
import { isFilled } from '../data/utils';

/* The frame shows the featured video's own thumbnail when a work entry
   matches its URL; otherwise it stays a plain frame. */
const featuredEntry = [work.feature, ...work.entries].find(
  (item) => item.url === featuredVideo.url
);
---

<a
  class="frame"
  href={featuredVideo.url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Watch: ${featuredVideo.title}`}
>
  <div class="frame__stack">
    <span class="frame__ghost frame__ghost--far" aria-hidden="true"></span>
    <span class="frame__ghost frame__ghost--near" aria-hidden="true"></span>

    <div class="frame__panel">
      {
      featuredEntry && (
        <Image
          class="frame__img"
          src={featuredEntry.thumb}
          alt={featuredEntry.thumbAlt}
          width={1080}
          loading="eager"
          fetchpriority="high"
        />
      )
    }

      {isFilled(featuredVideo.duration) && <span class="frame__chip">{featuredVideo.duration}</span>}

      <span class="frame__play" aria-hidden="true">
        <span class="frame__ring"></span>
        <span class="frame__triangle"></span>
      </span>

      <span class="frame__progress"><span class="frame__progress-fill"></span></span>
    </div>
  </div>

  <div class="frame__caption">
    <p class="frame__title">{featuredVideo.title}</p>
    {isFilled(featuredVideo.views) && <p class="frame__views">{featuredVideo.views}</p>}
  </div>
</a>

<style>
  .frame {
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --dur: 0.55s;

    display: block;
    width: 100%;
    max-width: 540px;
    text-decoration: none;
  }

  .frame__stack {
    position: relative;
    width: 100%;
    padding-top: 32px;
  }

  /* Soft accent glow behind the whole stack. */
  .frame__stack::before {
    content: '';
    position: absolute;
    inset: -12%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* The two empty panels behind the main one: a body of work. */
  .frame__ghost {
    position: absolute;
    left: 50%;
    top: 32px;
    height: 304px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--glass-bg);
    z-index: 1;
    transition: transform var(--dur) var(--ease);
  }

  /* 460/540 and 500/540 of the stack, kept proportional as it shrinks. */
  .frame__ghost--far {
    width: 85.2%;
    transform: translate(-50%, -32px);
  }

  .frame__ghost--near {
    width: 92.6%;
    transform: translate(-50%, -16px);
  }

  .frame__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 304px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .frame__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Solid pill, bottom-right, clear of the play button. */
  .frame__chip {
    position: absolute;
    right: 12px;
    bottom: 16px;
    border-radius: 999px;
    background: var(--bg-base);
    padding: 4px 10px;
    font-size: 11px;
    letter-spacing: 0.4px;
    color: var(--text-secondary);
  }

  .frame__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid color-mix(in srgb, var(--text-primary) 45%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg-base) 55%, transparent);
    transition: background var(--dur) var(--ease);
  }

  /* Ring pulsing outward behind the play button. */
  .frame__ring {
    position: absolute;
    inset: -1px;
    border: 1px solid color-mix(in srgb, var(--text-primary) 35%, transparent);
    border-radius: 50%;
    animation: frame-pulse 2.8s var(--ease) infinite;
    pointer-events: none;
  }

  @keyframes frame-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.65);
      opacity: 0;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  /* CSS-triangle play glyph, nudged right to sit optically centred. */
  .frame__triangle {
    width: 0;
    height: 0;
    margin-left: 3px;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 11px solid var(--text-primary);
    transition: border-left-color var(--dur) var(--ease);
  }

  /* Scrubber pinned to the bottom edge of the image. */
  .frame__progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    height: 2px;
    background: var(--hairline);
  }

  .frame__progress-fill {
    display: block;
    width: 34%;
    height: 100%;
    background: linear-gradient(90deg, var(--cyan), var(--accent));
  }

  /* Caption below the image, never over it. */
  .frame__caption {
    margin-top: 14px;
  }

  .frame__title {
    margin: 0;
    font-size: 14px;
    font-weight: var(--body-weight-medium);
    line-height: 1.45;
    color: var(--text-primary);
  }

  .frame__views {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--text-muted);
  }

  /* Hover: rear panels fan further up, main panel lifts, play button fills. */
  .frame:hover .frame__ghost--near,
  .frame:focus-visible .frame__ghost--near {
    transform: translate(-50%, -26px);
  }

  .frame:hover .frame__ghost--far,
  .frame:focus-visible .frame__ghost--far {
    transform: translate(-50%, -48px);
  }

  .frame:hover .frame__panel,
  .frame:focus-visible .frame__panel {
    transform: translateY(-7px);
    border-color: var(--accent);
  }

  .frame:hover .frame__play,
  .frame:focus-visible .frame__play {
    background: var(--text-primary);
  }

  .frame:hover .frame__triangle,
  .frame:focus-visible .frame__triangle {
    border-left-color: var(--bg-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame__ghost,
    .frame__panel,
    .frame__play,
    .frame__triangle {
      transition: none;
    }

    .frame__ring {
      animation: none;
    }

    .frame:hover .frame__ghost--near,
    .frame:hover .frame__ghost--far,
    .frame:hover .frame__panel {
      transform: translate(-50%, -16px);
    }

    .frame:hover .frame__ghost--far {
      transform: translate(-50%, -32px);
    }

    .frame:hover .frame__panel {
      transform: none;
    }
  }
</style>
