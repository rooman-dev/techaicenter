---
import { trustedBy } from '../data/site';
---

<section id="trusted-by" class="trusted">
  <div class="trusted__inner">
    <p class="trusted__label">Trusted by</p>
    <ul class="trusted__list">
      {trustedBy.map((brand) => <li class="trusted__brand">{brand}</li>)}
    </ul>
  </div>
</section>

<style>
  .trusted {
    width: 100%;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .trusted__inner {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 68rem;
    padding: 1.5rem 1.25rem;
  }

  .trusted__label {
    margin: 0;
    flex: none;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--text-muted);
  }

  .trusted__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trusted__brand {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 27px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
    color: var(--text-muted);
    cursor: default;
    transition:
      color 220ms ease,
      -webkit-text-stroke-color 220ms ease;
  }

  /* Hover hollows the name out: fill drops away, a hairline stroke remains. */
  .trusted__brand:hover {
    color: transparent;
    -webkit-text-stroke: 1px var(--text-secondary);
  }

  @media (min-width: 64rem) {
    .trusted__inner {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 1.75rem 1.25rem;
    }

    .trusted__list {
      flex: 1;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trusted__brand {
      transition: none;
    }
  }
</style>
