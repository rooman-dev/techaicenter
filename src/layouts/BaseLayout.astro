---
import '../styles/global.css';
import { profile } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Defaults to the home page title. Legal pages pass their own. */
  title?: string;
  description?: string;
  /** Keeps a page out of search results, e.g. the post-submit thanks page. */
  noindex?: boolean;
}

const { title = profile.title, description = profile.tagline, noindex = false } = Astro.props;

/* Link previews ignore relative URLs, so these are made absolute against
   `site` in astro.config.mjs. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    {/* TODO before launch: /og.png is a blank 1200x630 placeholder. Replace it
        with the real share card — it is what agencies see when the link is
        pasted into Slack, LinkedIn or a DM. */}
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Self-hosted: no third-party connection, no render-blocking stylesheet. */}
    <link
      rel="preload"
      href="/fonts/big-shoulders-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <script>
      // One observer for every typewriter heading. Headings are visible until
      // this runs, so a blocked or failed script cannot swallow one.
      //
      // The observed element is the HEADING, never the .tw span itself: a
      // hidden span is clipped to `inset(0 100% 0 0)`, i.e. zero width, and a
      // zero-area box never reports as intersecting — it could never trigger
      // its own reveal. That deadlock is why headings only appeared once the
      // safety timeout fired.
      (() => {
        const root = document.documentElement;
        root.classList.remove('no-js');

        const spans = Array.from(document.querySelectorAll<HTMLElement>('.tw'));
        if (spans.length === 0) return;

        const reveal = (el: HTMLElement) => {
          if (el.classList.contains('is-typed')) return;
          el.classList.add('is-typed');
          el.addEventListener('animationend', () => el.classList.add('is-done'), { once: true });
        };

        const revealGroup = (host: Element) =>
          host.querySelectorAll<HTMLElement>('.tw').forEach(reveal);

        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          spans.forEach(reveal);
          return;
        }

        // Group the spans by the heading that holds them.
        const hosts = new Set<Element>();
        spans.forEach((span) => hosts.add(span.closest('h1, h2, h3') ?? span.parentElement ?? span));

        // Only now may CSS hide anything.
        root.classList.add('tw-ready');

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              revealGroup(entry.target);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -5% 0px', threshold: 0.15 }
        );

        hosts.forEach((host) => observer.observe(host));

        // Safety net: reveal what is ON SCREEN but still hidden — never the
        // whole page, or everything below the fold would be shown before it
        // was ever reached.
        const sweep = () => {
          hosts.forEach((host) => {
            const box = host.getBoundingClientRect();
            if (box.top < window.innerHeight && box.bottom > 0) {
              revealGroup(host);
              observer.unobserve(host);
            }
          });
        };

        window.addEventListener('load', sweep);
        window.setTimeout(sweep, 2500);

        // Belt and braces. The observer is the primary path, but it has been
        // seen to stay silent for a heading it is demonstrably observing, and
        // a heading that never reveals is worse than a cheap listener. This
        // one is passive, runs at most once per frame, only measures hosts
        // that are still hidden, and removes itself once they are all done.
        let queued = false;
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sweep();
            if (spans.every((el) => el.classList.contains('is-typed'))) {
              window.removeEventListener('scroll', onScroll);
            }
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
